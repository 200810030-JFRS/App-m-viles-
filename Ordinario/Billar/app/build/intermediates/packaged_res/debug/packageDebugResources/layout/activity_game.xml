<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0F1822"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:id="@+id/panelPlayer1"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_active_turn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvP1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvP1Group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_open"
                    android:textColor="@color/emerald_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.example.billar.view.PocketedBallsBarView
                android:id="@+id/p1PocketedView"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_badge_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:text="Saque inicial — Jugador 1"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/panelPlayer2"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_inactive_turn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <com.example.billar.view.PocketedBallsBarView
                android:id="@+id/p2PocketedView"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvP2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_cpu"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvP2Group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_open"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpin"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/btn_spin"
            android:textSize="11sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSound"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="🔊"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/stroke_subtle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestart"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="↻"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/stroke_subtle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenu"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/btn_menu"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/stroke_subtle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.example.billar.view.PoolTableView
            android:id="@+id/poolTableView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.example.billar.view.PowerMeterView
            android:id="@+id/powerMeterView"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="10dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

</LinearLayout>
