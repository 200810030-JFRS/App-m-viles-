<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/spin_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/spin_dialog_desc"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.example.billar.view.CueSpinView
        android:id="@+id/cueSpinView"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvSpinLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Golpe centrado (Sin efecto)"
        android:textColor="@color/emerald_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetSpin"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="@string/btn_reset_spin"
        android:textColor="@color/text_primary" />

</LinearLayout>
